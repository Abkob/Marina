{
  "name": "marina-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,green \"vite --port=3000 --host=0.0.0.0\" \"tsx watch server/index.ts\"",
    "server": "tsx watch server/index.ts",
    "migrate": "tsx server/migrate.ts",
    "build": "vite build",
    "check": "npm run lint && npm test && npm run build && npm run vercel:entry-check && npm run vercel:preflight",
    "db:check": "tsx scripts/data-integrity-check.ts",
    "db:deploy": "tsx scripts/deploy-schema.ts",
    "backup:create": "tsx scripts/create-portable-backup.ts",
    "backup:verify": "tsx scripts/verify-portable-backup.ts",
    "backup:restore": "tsx scripts/restore-portable-backup.ts",
    "storage:migrate": "tsx scripts/migrate-storage-to-blob.ts",
    "vercel:bundle": "esbuild api/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=tmp/vercel-api.mjs",
    "vercel:entry-check": "npm run vercel:bundle && tsx scripts/check-serverless-entry.ts",
    "vercel:preflight": "tsx scripts/vercel-preflight.ts",
    "vercel:preflight:env": "tsx scripts/vercel-preflight.ts --env",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.10.0",
    "@openai/codex-sdk": "^0.144.4",
    "@react-sigma/core": "^5.0.6",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/dompurify": "^3.0.5",
    "@types/pdf-parse": "^1.1.5",
    "@vercel/blob": "^2.6.1",
    "@vercel/functions": "^3.7.6",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.11",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.5",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "ollama": "^0.5.18",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pg-query-stream": "^4.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-force-graph-2d": "^1.29.1",
    "sigma": "^3.0.3",
    "unzipper": "^0.12.5",
    "vite": "^6.2.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/marked": "^5.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/pg-query-stream": "^1.0.3",
    "@types/unzipper": "^0.10.11",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
