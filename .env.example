# Database
# Local example: postgresql://postgres:pgadmin@localhost:5433/marina
# Vercel: use a managed PostgreSQL URL with pgcrypto and pgvector enabled.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DATABASE_POOL_MAX="3"

# Public deployment URL. Use the preview URL while testing, then production.
APP_URL="https://your-project.vercel.app"

# Personal-app authentication (required in production and on Vercel)
# Use a unique password of 12+ characters and a random secret of 32+ characters.
MARINA_AUTH_REQUIRED="true"
MARINA_ACCESS_PASSWORD="replace-with-a-long-unique-password"
MARINA_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Google Drive resources and optional Tasks + Calendar sync. Enable Drive API
# in the OAuth project's Google Cloud console. Create an OAuth 2.0 Web client
# with this exact redirect URI:
# https://your-project.vercel.app/api/google/oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-project.vercel.app/api/google/oauth/callback"
# Use separate random values (32+ characters). Refresh tokens are encrypted
# with the first; OAuth callbacks are signed with the second.
GOOGLE_TOKEN_ENCRYPTION_KEY=""
GOOGLE_OAUTH_STATE_SECRET=""

# Vercel Cron authenticates with this value as a Bearer token.
CRON_SECRET="replace-with-at-least-32-random-characters"

# Created by a PRIVATE Vercel Blob store connected to the project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"

# Cloud AI. A laptop-only Ollama URL is not reachable from Vercel.
PROVIDER_MODE="hybrid"
GEMINI_API_KEY="replace-with-your-gemini-key"
MARINA_MAIN_MODEL="nvidia/nemotron-3-super-120b-a12b"
MARINA_EMBEDDING_MODEL="gemini-embedding-2"
MARINA_EMBEDDING_DIMENSION="3072"

# Optional NVIDIA cloud fallback
NVIDIA_API_KEY=""
NVIDIA_API_BASE="https://integrate.api.nvidia.com/v1"
# Evidence specialists share NVIDIA_API_KEY; selected passages/pages leave the server.
# Shared development endpoints may be throttled. Disable both roles with false.
MARINA_NVIDIA_EVIDENCE_ENABLED=true
MARINA_NVIDIA_RERANK_MODEL="nvidia/llama-nemotron-rerank-vl-1b-v2"
MARINA_NVIDIA_RERANK_URL="https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking"
MARINA_NVIDIA_VISION_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
MARINA_NVIDIA_NEMOTRON_MODEL="nvidia/nemotron-3-super-120b-a12b"
MARINA_NVIDIA_DEEPSEEK_MODEL="deepseek-ai/deepseek-v4-pro"
MARINA_NVIDIA_FALLBACK_MODEL="deepseek-ai/deepseek-v4-pro"
MARINA_NVIDIA_TIMEOUT_MS="90000"
MARINA_NVIDIA_THINKING="false"
MARINA_DEEPSEEK_THINKING="false"
MARINA_NVIDIA_REASONING_BUDGET="4096"
MARINA_NVIDIA_TEMPERATURE="1"
MARINA_NVIDIA_TOP_P="0.95"

# Raw journal text is not sent to cloud embedding providers unless enabled.
ALLOW_CLOUD_RAW_TEXT="false"

# Local-only options (these are intentionally disabled on Vercel)
OLLAMA_HOST="http://localhost:11434"
MARINA_LOCAL_FALLBACK_MODEL="qwen3:8b"
MARINA_AUTO_BACKUP="false"
OBSIDIAN_VAULT_SYNC="false"

# Destructive/admin features stay disabled unless deliberately enabled.
ALLOW_FACTORY_RESET="false"
ALLOW_DIRECT_AI_APPLY="false"
MARINA_CODEX_WORKER_ENABLED="false"
# CODEX_API_KEY=""
# MARINA_CODEX_MODEL=""
# Resource processing: production requires both keys and /api/inngest synced
# in Inngest. For its local dev server only, set INNGEST_DEV=1 instead.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
